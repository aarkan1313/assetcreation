  "version": 3,
  "_v3_fields": {
    "prop_pool": "list of prop ids in world/props/library/<id>/ (must have model_lod0.glb + prop.json). Sampled per scatter instance.",
    "prop_weights": "optional sampling distribution; same length as prop_pool; defaults to uniform.",
    "lod_swap_distances_m": "optional override for VisibilityRange ends. Defaults to per-prop prop.json.lods[*].max_distance_m.",
    "render_class_hint": "optional per-asset hint. If absent, the prop's own render_class controls Godot scatter mode (scatter_multimesh -> MultiMesh chunked by 8m terrain region; scene_prop -> plain instance)."
  },
