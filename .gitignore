# Worldgen + factory ignore. Strategy: ignore the giant model/venv/cache
# directories entirely; track source code, configs, docs, schemas, small assets.

# ============ ENORMOUS — never ever commit ============
# AI model checkouts (each is 10-50 GB of weights + venvs + caches)
animators/

# DEM TIFF cache (~9 GB, regenerated from OpenTopography on demand)
pipelines/terrain/source_dems/
pipelines/terrain/output/

# Generated texture library (regenerated from FLUX prompts)
world/textures/library/

# Worldgen v2 per-job outputs (regenerated by pipeline)
pipelines/worldgen_v2/output/

# Other pipeline outputs
pipelines/textures/output/
pipelines/textures/cache/

# Meshy character outputs (regenerated)
meshy/output/
meshy/preprocessed/
meshy/sprites/
meshy/previews/
meshy/mixamo_ready/
meshy/batch_logs/
meshy/preprocessed*/

# World generated content
world/worlds/*/output/
world/maps/*.png
world/maps/*.json

# Audio generated content (regenerated)
audio/output/
audio/cache/

# VFX baked outputs (large particle JSON dumps)
vfx/output/
vfx/baked/
vfx/migrated_from_spell_lab/

# Hunyuan3D / Trellis2 generated GLBs (regenerated by AI route)
world/props/ai_routes/

# Stitched / large generated heightmaps in world/worlds (regenerated)
world/worlds/*/height_16.png
world/worlds/*/normal.png
world/worlds/*/splat_rgba.png
world/worlds/*/biome.png
world/worlds/*/*.tres
world/worlds/*/godot/

# Godot pack large prop GLBs (regenerated by props pipeline)
godot_pack/props/
godot_pack/materials/*/
godot_pack/terrain/

# Audio music stems (large WAVs, regenerated)
audio/music/

# meshy patterns expanded (preprocessed01, preprocessed02, etc.)
meshy/preprocessed*/

# Old archives — reference only, not tracked
_archive/
research/_archive/
docs/_archive/

# ============ Python ============
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.pytest_tmp/
**/tmp_pytest_manual/
*.egg-info/

# ============ Godot project caches (keep source .tscn / .gdshader / .gd) ============
worldgen2/.godot/
worldgen2/.import/
# Generated PNGs in the Godot project (regenerated by pipeline)
worldgen2/terrain/*/height_16.png
worldgen2/terrain/*/biome_splat_rgba.png
worldgen2/terrain/*/albedo_*.png
worldgen2/terrain/*/*.import

# ============ Model weights / safetensors / checkpoints ============
*.safetensors
*.ckpt
*.bin
*.gguf
*.onnx
*.pt
*.pth
*.npz
*.npy
*.pkl

# ============ Heavy media ============
*.tif
*.tiff
*.webm
*.mp4
*.mov
*.wav
*.flac
*.mp3
*.glb
*.fbx
*.gltf
*.usd
*.usdz
*.exr
*.hdr
*.tga
# Large PNGs — limit to source, not generated
images/*_2k.png
images/*_4k.png

# ============ Secrets / env ============
*.env
.env.*
**/credentials.json
**/secrets.json
~/.opentopo_calls.jsonl
.opentopo_calls.jsonl
hf_*

# ============ OS / editor noise ============
.DS_Store
Thumbs.db
*.swp
*~
*.log

# ============ Temp dump dirs ============
D:/tmp/
/tmp/
**/tmp/
