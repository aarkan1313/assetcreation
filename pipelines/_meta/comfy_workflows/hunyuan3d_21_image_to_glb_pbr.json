{
  "_doc": "Hunyuan3D-2.1 IMAGE -> PBR-textured GLB workflow (visualbruno chain). Full v2.1 path: image -> Hy3DMeshGenerator (latents) -> Hy3D21VAELoader+Decode (mesh) -> Hy3D21PostprocessMesh -> Hy3D21CameraConfig -> Hy3DMultiViewsGenerator (paint pipe + albedo/mr/normal/position multi-view bake) -> Hy3DBakeMultiViews (project to UV texture) -> Hy3DInPaint (vertex-aware fill + save GLB with embedded albedo + metallic_roughness textures). Auto-downloads tencent/Hunyuan3D-2.1 paintpbr-v2-1 to models/diffusers/ on first run (~5 GB).",
  "_owner": "pipelines/props/hunyuan3d_route.py",
  "_required_models": [
    "models/diffusion_models/hunyuan3d-dit-v2-1.ckpt",
    "models/vae/hunyuan3d-vae-v2-1.ckpt",
    "models/diffusers/hunyuan3d-paintpbr-v2-1/ (auto-download)"
  ],
  "_node_packs": [
    "ComfyUI-Hunyuan3d-2-1 (visualbruno)"
  ],

  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "source.png"
    }
  },

  "2": {
    "class_type": "Hy3DMeshGenerator",
    "inputs": {
      "model": "hunyuan3d-dit-v2-1.ckpt",
      "image": ["1", 0],
      "steps": 30,
      "guidance_scale": 5.0,
      "seed": 42,
      "attention_mode": "sdpa"
    }
  },

  "3": {
    "class_type": "Hy3D21VAELoader",
    "inputs": {
      "model_name": "hunyuan3d-vae-v2-1.ckpt"
    }
  },

  "4": {
    "class_type": "Hy3D21VAEDecode",
    "inputs": {
      "vae": ["3", 0],
      "latents": ["2", 0],
      "box_v": 1.01,
      "octree_resolution": 384,
      "num_chunks": 8000,
      "mc_level": 0.0,
      "mc_algo": "mc",
      "enable_flash_vdm": true,
      "force_offload": true
    }
  },

  "5": {
    "class_type": "Hy3D21PostprocessMesh",
    "inputs": {
      "trimesh": ["4", 0],
      "remove_floaters": true,
      "remove_degenerate_faces": true,
      "reduce_faces": true,
      "max_facenum": 40000,
      "smooth_normals": false
    }
  },

  "6": {
    "class_type": "Hy3D21CameraConfig",
    "inputs": {
      "camera_azimuths": "0, 90, 180, 270, 0, 180",
      "camera_elevations": "0, 0, 0, 0, 90, -90",
      "view_weights": "1, 0.1, 0.5, 0.1, 0.05, 0.05",
      "ortho_scale": 1.2
    }
  },

  "7": {
    "class_type": "Hy3DMultiViewsGenerator",
    "inputs": {
      "trimesh": ["5", 0],
      "camera_config": ["6", 0],
      "view_size": 512,
      "image": ["1", 0],
      "steps": 10,
      "guidance_scale": 3.0,
      "texture_size": 1024,
      "unwrap_mesh": true,
      "seed": 42
    }
  },

  "8": {
    "class_type": "Hy3DBakeMultiViews",
    "inputs": {
      "pipeline": ["7", 0],
      "camera_config": ["7", 5],
      "albedo": ["7", 1],
      "mr": ["7", 2]
    }
  },

  "9": {
    "class_type": "Hy3DInPaint",
    "inputs": {
      "pipeline": ["8", 0],
      "albedo": ["8", 1],
      "albedo_mask": ["8", 2],
      "mr": ["8", 3],
      "mr_mask": ["8", 4],
      "output_mesh_name": "ruined_obelisk_a_pbr"
    }
  }
}
