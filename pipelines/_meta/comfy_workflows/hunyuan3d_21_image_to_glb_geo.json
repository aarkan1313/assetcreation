{
  "_doc": "Hunyuan3D-2.1 GEOMETRY-ONLY workflow (visualbruno chain). Uses Hy3DMeshGenerator (single-file pipeline w/ dit_config_2_1.yaml) + Hy3D21VAELoader (ShapeVAE w/ explicit config) + Hy3D21VAEDecode + Hy3D21PostprocessMesh + Hy3D21ExportMesh. Inputs: ./input/source.png + Tencent's hunyuan3d-dit-v2-1.ckpt + hunyuan3d-vae-v2-1.ckpt. Visualbruno's loader reads .ckpt directly — no kijai prefix-stripping required.",
  "_owner": "pipelines/props/hunyuan3d_route.py",
  "_required_models": [
    "models/diffusion_models/hunyuan3d-dit-v2-1.ckpt",
    "models/vae/hunyuan3d-vae-v2-1.ckpt"
  ],
  "_node_packs": [
    "ComfyUI-Hunyuan3d-2-1 (visualbruno)"
  ],

  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "source.png"
    }
  },
  "2": {
    "class_type": "Hy3DMeshGenerator",
    "inputs": {
      "model": "hunyuan3d-dit-v2-1.ckpt",
      "image": ["1", 0],
      "steps": 30,
      "guidance_scale": 5.0,
      "seed": 42,
      "attention_mode": "sdpa"
    }
  },
  "3": {
    "class_type": "Hy3D21VAELoader",
    "inputs": {
      "model_name": "hunyuan3d-vae-v2-1.ckpt"
    }
  },
  "4": {
    "class_type": "Hy3D21VAEDecode",
    "inputs": {
      "vae": ["3", 0],
      "latents": ["2", 0],
      "box_v": 1.01,
      "octree_resolution": 384,
      "num_chunks": 8000,
      "mc_level": 0.0,
      "mc_algo": "mc",
      "enable_flash_vdm": true,
      "force_offload": true
    }
  },
  "5": {
    "class_type": "Hy3D21PostprocessMesh",
    "inputs": {
      "trimesh": ["4", 0],
      "remove_floaters": true,
      "remove_degenerate_faces": true,
      "reduce_faces": true,
      "max_facenum": 40000,
      "smooth_normals": false
    }
  },
  "6": {
    "class_type": "Hy3D21ExportMesh",
    "inputs": {
      "trimesh": ["5", 0],
      "filename_prefix": "props/hy3d_21",
      "file_format": "glb",
      "save_file": true
    }
  }
}
