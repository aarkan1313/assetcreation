{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "Where did this record come from? Generation audit trail.",
      "properties": {
        "source": {
          "default": "synthetic",
          "enum": [
            "llm",
            "human",
            "seed",
            "import",
            "synthetic"
          ],
          "title": "Source",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "prompt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Id"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "target_file_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target File Sha256"
        },
        "constraint_technique": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint Technique"
        },
        "constraint_pass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint Pass"
        },
        "sim_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sim Digest"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        }
      },
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_]{1,39}$",
      "title": "Id",
      "type": "string"
    },
    "display_name": {
      "maxLength": 64,
      "minLength": 2,
      "title": "Display Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tags": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "type": "string"
      },
      "maxItems": 12,
      "title": "Tags",
      "type": "array"
    },
    "localization_key": {
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "title": "Localization Key",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "notes": {
      "default": "",
      "maxLength": 512,
      "title": "Notes",
      "type": "string"
    },
    "canonical_spelling": {
      "maxLength": 64,
      "minLength": 2,
      "title": "Canonical Spelling",
      "type": "string"
    },
    "aliases": {
      "items": {
        "maxLength": 64,
        "minLength": 2,
        "type": "string"
      },
      "maxItems": 8,
      "title": "Aliases",
      "type": "array"
    },
    "category": {
      "enum": [
        "place",
        "person",
        "concept",
        "artifact",
        "event",
        "deity"
      ],
      "title": "Category",
      "type": "string"
    },
    "description": {
      "maxLength": 600,
      "minLength": 8,
      "title": "Description",
      "type": "string"
    },
    "source_doc": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Doc"
    }
  },
  "required": [
    "id",
    "display_name",
    "localization_key",
    "canonical_spelling",
    "category",
    "description"
  ],
  "title": "LoreTerm",
  "type": "object"
}