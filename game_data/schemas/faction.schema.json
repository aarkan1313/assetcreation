{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "Where did this record come from? Generation audit trail.",
      "properties": {
        "source": {
          "default": "synthetic",
          "enum": [
            "llm",
            "human",
            "seed",
            "import",
            "synthetic"
          ],
          "title": "Source",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "prompt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Id"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "target_file_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target File Sha256"
        },
        "constraint_technique": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint Technique"
        },
        "constraint_pass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint Pass"
        },
        "sim_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sim Digest"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        }
      },
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_]{1,39}$",
      "title": "Id",
      "type": "string"
    },
    "display_name": {
      "maxLength": 64,
      "minLength": 2,
      "title": "Display Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tags": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "type": "string"
      },
      "maxItems": 12,
      "title": "Tags",
      "type": "array"
    },
    "localization_key": {
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "title": "Localization Key",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "notes": {
      "default": "",
      "maxLength": 512,
      "title": "Notes",
      "type": "string"
    },
    "ideology": {
      "maxLength": 64,
      "minLength": 4,
      "title": "Ideology",
      "type": "string"
    },
    "primary_color": {
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "title": "Primary Color",
      "type": "string"
    },
    "secondary_color": {
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "title": "Secondary Color",
      "type": "string"
    },
    "territory": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Territory",
      "type": "array"
    },
    "allies": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{1,39}$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Allies",
      "type": "array"
    },
    "enemies": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{1,39}$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Enemies",
      "type": "array"
    },
    "sigil_prompt": {
      "default": "",
      "maxLength": 200,
      "title": "Sigil Prompt",
      "type": "string"
    },
    "description": {
      "maxLength": 400,
      "minLength": 8,
      "title": "Description",
      "type": "string"
    }
  },
  "required": [
    "id",
    "display_name",
    "localization_key",
    "ideology",
    "primary_color",
    "secondary_color",
    "description"
  ],
  "title": "Faction",
  "type": "object"
}