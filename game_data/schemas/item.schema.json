{
  "$defs": {
    "ItemStats": {
      "additionalProperties": false,
      "properties": {
        "damage": {
          "default": 0,
          "maximum": 999,
          "minimum": 0,
          "title": "Damage",
          "type": "integer"
        },
        "armor": {
          "default": 0,
          "maximum": 999,
          "minimum": 0,
          "title": "Armor",
          "type": "integer"
        },
        "weight": {
          "default": 0.0,
          "maximum": 999.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        },
        "durability": {
          "default": 100,
          "maximum": 9999,
          "minimum": 0,
          "title": "Durability",
          "type": "integer"
        },
        "value_gold": {
          "default": 0,
          "maximum": 999999,
          "minimum": 0,
          "title": "Value Gold",
          "type": "integer"
        }
      },
      "title": "ItemStats",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where did this record come from? Generation audit trail.",
      "properties": {
        "source": {
          "default": "synthetic",
          "enum": [
            "llm",
            "human",
            "seed",
            "import",
            "synthetic"
          ],
          "title": "Source",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "prompt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Id"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "target_file_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target File Sha256"
        },
        "constraint_technique": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint Technique"
        },
        "constraint_pass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint Pass"
        },
        "sim_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sim Digest"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        }
      },
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_]{1,39}$",
      "title": "Id",
      "type": "string"
    },
    "display_name": {
      "maxLength": 64,
      "minLength": 2,
      "title": "Display Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tags": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "type": "string"
      },
      "maxItems": 12,
      "title": "Tags",
      "type": "array"
    },
    "localization_key": {
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "title": "Localization Key",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "notes": {
      "default": "",
      "maxLength": 512,
      "title": "Notes",
      "type": "string"
    },
    "category": {
      "enum": [
        "weapon",
        "armor",
        "consumable",
        "material",
        "quest",
        "tool"
      ],
      "title": "Category",
      "type": "string"
    },
    "rarity": {
      "default": "common",
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary"
      ],
      "title": "Rarity",
      "type": "string"
    },
    "damage_type": {
      "anyOf": [
        {
          "enum": [
            "physical",
            "fire",
            "cold",
            "lightning",
            "poison",
            "arcane",
            "holy",
            "shadow"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Damage Type"
    },
    "stats": {
      "$ref": "#/$defs/ItemStats"
    },
    "icon_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{1,39}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Icon Id"
    },
    "description": {
      "maxLength": 400,
      "minLength": 8,
      "title": "Description",
      "type": "string"
    },
    "stack_max": {
      "default": 1,
      "maximum": 9999,
      "minimum": 1,
      "title": "Stack Max",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "display_name",
    "localization_key",
    "category",
    "description"
  ],
  "title": "Item",
  "type": "object"
}