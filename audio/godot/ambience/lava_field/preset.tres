[gd_resource type="Resource" script_class="BiomeAmbiencePreset" load_steps=5 format=3]

[ext_resource type="AudioStream" path="res://audio/ambience/lava_field/bed_drone.wav" id="1_bed_drone"]
[ext_resource type="AudioStream" path="res://audio/ambience/lava_field/bed_air.wav" id="2_bed_air"]
[ext_resource type="AudioStream" path="res://audio/ambience/lava_field/wildlife/randomizer.tres" id="3_wildlife"]
[ext_resource type="AudioStream" path="res://audio/ambience/lava_field/distant/randomizer.tres" id="4_distant"]

[resource]
biome_id = "lava_field"
bed_drone = ExtResource("1_bed_drone")
bed_air = ExtResource("2_bed_air")
wildlife_randomizer = ExtResource("3_wildlife")
distant_randomizer = ExtResource("4_distant")
reverb_room_size = 0.6
reverb_damp = 0.4
reverb_wet = 0.15
reverb_predelay_ms = 30.0
wildlife_lambda = 0.05
distant_lambda = 0.01
