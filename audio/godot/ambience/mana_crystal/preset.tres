[gd_resource type="Resource" script_class="BiomeAmbiencePreset" load_steps=5 format=3]

[ext_resource type="AudioStream" path="res://audio/ambience/mana_crystal/bed_drone.wav" id="1_bed_drone"]
[ext_resource type="AudioStream" path="res://audio/ambience/mana_crystal/bed_air.wav" id="2_bed_air"]
[ext_resource type="AudioStream" path="res://audio/ambience/mana_crystal/wildlife/randomizer.tres" id="3_wildlife"]
[ext_resource type="AudioStream" path="res://audio/ambience/mana_crystal/distant/randomizer.tres" id="4_distant"]

[resource]
biome_id = "mana_crystal"
bed_drone = ExtResource("1_bed_drone")
bed_air = ExtResource("2_bed_air")
wildlife_randomizer = ExtResource("3_wildlife")
distant_randomizer = ExtResource("4_distant")
reverb_room_size = 0.75
reverb_damp = 0.2
reverb_wet = 0.3
reverb_predelay_ms = 50.0
wildlife_lambda = 0.05
distant_lambda = 0.01
